{#- Sprachumschalter oben rechts im Header. -#}
{%- set switchUrl = altUrl or i18n[otherLang].home %}
<div class="lang-switch" role="group" aria-label="{{ t.langSwitchLabel }}">
  {%- if lang == "de" %}
  <span class="lang-option is-current" lang="de" aria-current="true">DE</span>
  <a class="lang-option" href="{{ switchUrl }}" hreflang="en" lang="en" title="Read in English">EN</a>
  {%- else %}
  <a class="lang-option" href="{{ switchUrl }}" hreflang="de" lang="de" title="Auf Deutsch lesen">DE</a>
  <span class="lang-option is-current" lang="en" aria-current="true">EN</span>
  {%- endif %}
</div>
