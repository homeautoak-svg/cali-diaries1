{#- Gemalte Übersichtskarte aller Trips (seit 1.8.0); Pins und Liste verlinken zu den Berichten -#}
{%- set karte = (collections.orte_en if lang == "en" else collections.orte) | uebersichtskarte(lang) %}
<h1 class="page-title">{{ mapHeading }}</h1>

{% if karte.svg %}
<div class="overview-map">{{ karte.svg | safe }}</div>

<ol class="overview-list">
  {%- for t in karte.trips %}
  <li data-nr="{{ t.nr }}">
    <a href="{{ t.url }}">
      <span class="nr">{{ t.nr }}</span>
      <span class="txt"><b>{{ t.name }}</b><small>{{ t.ort }} · {{ t.datum }}</small></span>
    </a>
  </li>
  {%- endfor %}
</ol>

<script>
  // Pin und Listeneintrag gegenseitig hervorheben
  (function () {
    function mark(nr, on) {
      document.querySelectorAll('[data-nr="' + nr + '"]').forEach(function (el) { el.classList.toggle("hl", on); });
    }
    document.querySelectorAll(".overview-list li, .ov-pin").forEach(function (el) {
      var nr = el.getAttribute("data-nr");
      el.addEventListener("mouseenter", function () { mark(nr, true); });
      el.addEventListener("mouseleave", function () { mark(nr, false); });
      el.addEventListener("focusin", function () { mark(nr, true); });
      el.addEventListener("focusout", function () { mark(nr, false); });
    });
  })();
</script>
{% endif %}
