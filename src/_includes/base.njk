<!DOCTYPE html>
{%- set t = i18n[lang] %}
{%- set otherLang = "de" if lang == "en" else "en" %}
{%- set langPosts = collections.posts_en if lang == "en" else collections.posts %}
{%- set isHome = page.url == t.home %}
{%- set pageTitle = t.siteName if isHome else (title ~ " – " ~ t.siteName) %}
{%- set pageDescription = excerpt or (t.tagline if isHome) or t.description %}
{%- set altUrl = page.url | translationUrl(otherLang, collections.all) %}
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription | escape }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- if altUrl %}
{%- set deUrl = altUrl if lang == "en" else page.url %}
{%- set enUrl = page.url if lang == "en" else altUrl %}
<link rel="alternate" hreflang="de" href="{{ site.url }}{{ deUrl }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ deUrl }}">
{%- endif %}
<meta property="og:site_name" content="{{ t.siteName }}">
<meta property="og:locale" content="{{ t.ogLocale }}">
<meta property="og:type" content="{{ 'article' if hero_bild else 'website' }}">
<meta property="og:title" content="{{ (title if not isHome else t.siteName) | escape }}">
<meta property="og:description" content="{{ pageDescription | escape }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- set ogBild = hero_bild or (langPosts[0].data.hero_bild if isHome) %}
{%- if ogBild %}
<meta property="og:image" content="{{ site.url }}{{ ogBild }}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<link rel="alternate" type="application/rss+xml" title="{{ t.siteName }}" href="{{ '/en/feed.xml' if lang == 'en' else '/feed.xml' }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;600&display=swap">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body class="contour-bg">

{% if isHome %}
<header class="site-header">
  {% include "lang-switch.njk" %}
  <div class="eyebrow">VW T7 California · Andy &amp; Sarah</div>
  <h1><a href="{{ t.home }}">{{ t.siteName }}</a></h1>
  <p class="tagline">{{ t.tagline }}</p>
  {%- set st = (collections.trips_en if lang == "en" else collections.trips) | tripStats %}
  {% if st.trips %}
  <div class="stats">
    <div><b data-count="{{ st.trips }}">{{ st.trips }}</b><span>{{ t.statTrips }}</span></div>
    <div><b data-count="{{ st.nights }}">{{ st.nights }}</b><span>{{ t.statNights }}</span></div>
    <div><b data-count="{{ st.countries }}">{{ st.countries }}</b><span>{{ t.statCountries }}</span></div>
    <div><b data-count="{{ st.campsites }}">{{ st.campsites }}</b><span>{{ t.statCampsites }}</span></div>
  </div>
  <script>
    // Kennzahlen zählen beim Laden einmal hoch (nicht bei "Bewegung reduzieren")
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll(".stats [data-count]").forEach(function (el) {
        var end = +el.dataset.count, t0 = null;
        el.textContent = "0";
        requestAnimationFrame(function step(ts) {
          if (!t0) t0 = ts;
          var k = Math.min(1, (ts - t0) / 900);
          el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(step);
        });
      });
    }
  </script>
  {% endif %}
  {% include "nav.njk" %}
</header>
{% else %}
<header class="site-header site-header--compact">
  {% include "lang-switch.njk" %}
  <a class="site-title" href="{{ t.home }}">{{ t.siteName }}</a>
  {% include "nav.njk" %}
</header>
{% endif %}

<main>
  {{ content | safe }}
</main>

<footer class="site-footer">
  <img class="footer-van" src="/images/site-california-t7-side.png" alt="{{ t.vanAlt }}" sizes="6rem">
  <a href="{{ t.contactUrl }}">{{ t.navContact }}</a> · <a href="{{ t.privacyUrl }}">{{ t.privacy }}</a>
</footer>

</body>
</html>
