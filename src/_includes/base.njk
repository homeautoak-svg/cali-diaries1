<!DOCTYPE html>
{%- set t = i18n[lang] %}
{%- set otherLang = "de" if lang == "en" else "en" %}
{%- set langPosts = collections.posts_en if lang == "en" else collections.posts %}
{%- set isHome = page.url == t.home %}
{%- set pageTitle = t.siteName if isHome else (title ~ " – " ~ t.siteName) %}
{%- set pageDescription = excerpt or (t.tagline if isHome) or t.description %}
{%- set altUrl = page.url | translationUrl(otherLang, collections.all) %}
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription | escape }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- if altUrl %}
{%- set deUrl = altUrl if lang == "en" else page.url %}
{%- set enUrl = page.url if lang == "en" else altUrl %}
<link rel="alternate" hreflang="de" href="{{ site.url }}{{ deUrl }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ deUrl }}">
{%- endif %}
<meta property="og:site_name" content="{{ t.siteName }}">
<meta property="og:locale" content="{{ t.ogLocale }}">
<meta property="og:type" content="{{ 'article' if hero_bild else 'website' }}">
<meta property="og:title" content="{{ (title if not isHome else t.siteName) | escape }}">
<meta property="og:description" content="{{ pageDescription | escape }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- set ogBild = hero_bild or (langPosts[0].data.hero_bild if isHome) %}
{%- if ogBild %}
<meta property="og:image" content="{{ site.url }}{{ ogBild }}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;600&display=swap">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body class="contour-bg">

{% if isHome %}
<header class="site-header">
  <div class="eyebrow">VW T7 California · Andy &amp; Sarah</div>
  <h1><a href="{{ t.home }}">{{ t.siteName }}</a></h1>
  <p class="tagline">{{ t.tagline }}</p>
  {% include "nav.njk" %}
</header>
{% else %}
<header class="site-header site-header--compact">
  <a class="site-title" href="{{ t.home }}">{{ t.siteName }}</a>
  {% include "nav.njk" %}
</header>
{% endif %}

<main>
  {{ content | safe }}
</main>

<footer class="site-footer">
  <a href="{{ t.contactUrl }}">{{ t.navContact }}</a> · <a href="{{ t.privacyUrl }}">{{ t.privacy }}</a>
</footer>

</body>
</html>
