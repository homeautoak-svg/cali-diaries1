{%- set t = i18n[lang] %}
{%- set langPosts = collections.posts_en if lang == "en" else collections.posts -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ t.siteName }}</title>
    <link>{{ t.home | absoluteUrl(site.url) }}</link>
    <description>{{ t.description }}</description>
    <language>{{ t.htmlLang }}</language>
    <atom:link href="{{ page.url | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml"/>
    {%- for post in langPosts | sort(attribute='data.datum_sort', reverse=true) %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      <guid>{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.data.datum_sort | rfc822 }}</pubDate>
      <description>{{ post.data.excerpt | escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
