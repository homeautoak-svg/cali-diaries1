---
layout: base.njk
---
{%- set t = i18n[lang] %}
{%- set langPosts = collections.posts_en if lang == "en" else collections.posts %}
<a class="back-link" href="{{ t.home }}">← {{ t.allPosts }}</a>
<article class="post-detail">
  <div class="post-hero" data-placeholder-label="{{ t.photoFollows }}">
    {% if hero_bild %}<img src="{{ hero_bild }}" alt="{{ title | escape }}" sizes="(min-width: 56rem) 53rem, 100vw" data-eager>{% endif %}
  </div>
  <div class="post-kicker">
    <span>{{ datum | datumLang(lang) }}</span>
    {% if ort %}<span>{{ ort | ortLang(lang) }}</span>{% endif %}
  </div>
  <h1>{{ title }}</h1>

  {% if campingplatz or naechte or kosten_gesamt %}
  <dl class="fact-box">
    {% if campingplatz %}<div><dt>{{ t.campsite }}</dt><dd>{{ campingplatz }}</dd></div>{% endif %}
    {% if naechte %}<div><dt>{{ t.duration }}</dt><dd>{{ naechte }} {{ t.night if naechte == 1 else t.nights }}</dd></div>{% endif %}
    {% if kosten_gesamt %}<div><dt>{{ t.costTotal }}</dt><dd>CHF {{ kosten_gesamt | chf }}</dd></div>{% endif %}
  </dl>
  {% endif %}

  <div class="content">
    {{ content | safe }}
  </div>

  {% if fotos %}
  <div class="photo-strip">
    {% for foto in fotos %}{% if foto.foto != hero_bild %}
    <button type="button" class="photo" aria-label="{{ t.photoEnlarge | replace('%s', loop.index) }}" onclick="document.getElementById('lightbox-{{ loop.index }}').classList.add('open')">
      <img src="{{ foto.foto }}" alt="" sizes="(min-width: 56rem) 13rem, 45vw">
    </button>
    <div class="lightbox" id="lightbox-{{ loop.index }}" onclick="this.classList.remove('open')">
      <img src="{{ foto.foto }}" alt="" sizes="90vw">
      <span class="lightbox-close" aria-hidden="true">&times;</span>
    </div>
    {% endif %}{% endfor %}
  </div>
  <script>
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") document.querySelectorAll(".lightbox.open").forEach((el) => el.classList.remove("open"));
    });
  </script>
  {% endif %}

  {% if tags %}
  <section class="amenities" aria-label="{{ t.amenities }}">
    <h2>{{ t.amenities }}</h2>
    <ul>
      {% for tag in tags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set newer = langPosts | getPreviousCollectionItem %}
  {% set older = langPosts | getNextCollectionItem %}
  {% if newer or older %}
  <nav class="post-pager" aria-label="{{ t.morePosts }}">
    {% if older %}<a class="older" href="{{ older.url }}"><span>{{ t.olderPost }}</span>{{ older.data.title }}</a>{% endif %}
    {% if newer %}<a class="newer" href="{{ newer.url }}"><span>{{ t.newerPost }}</span>{{ newer.data.title }}</a>{% endif %}
  </nav>
  {% endif %}
</article>

{#- Strukturierte Daten für Suchmaschinen (schema.org BlogPosting) -#}
{%- set ld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": excerpt,
  "inLanguage": t.htmlLang,
  "datePublished": datum_sort | isoDate,
  "url": page.url | absoluteUrl(site.url),
  "mainEntityOfPage": page.url | absoluteUrl(site.url),
  "author": [{ "@type": "Person", "name": "Andy" }, { "@type": "Person", "name": "Sarah" }],
  "publisher": { "@type": "Organization", "name": t.siteName, "url": t.home | absoluteUrl(site.url) }
} %}
{%- if hero_bild %}{% set ld = ld | setAttr("image", hero_bild | absoluteUrl(site.url)) %}{% endif %}
{%- if campingplatz or (ort and not (ort | lower == "daheim")) %}
{%- set ld = ld | setAttr("contentLocation", { "@type": "Campground" if campingplatz else "Place", "name": campingplatz or ort, "address": ort }) %}
{%- endif %}
{%- if tags %}{% set ld = ld | setAttr("keywords", tags | join(", ")) %}{% endif %}
<script type="application/ld+json">{{ ld | dump | safe }}</script>
