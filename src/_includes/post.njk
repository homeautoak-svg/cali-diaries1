---
layout: base.njk
---
<a class="back-link" href="/">← Zurück zur Übersicht</a>

<article class="post-detail">
  <div class="post-hero" data-placeholder-label="Foto folgt">
    {% if hero_bild %}<img src="{{ hero_bild }}" alt="{{ title }}">{% endif %}
  </div>

  <div class="meta-row">
    <span>{{ datum }}</span>
    <span>{{ ort }}</span>
    {% if naechte %}<span>{{ naechte }} Nächte</span>{% endif %}
  </div>

  <h1>{{ title }}</h1>

  <div class="content">
    {{ content | safe }}
  </div>

  {% if fotos %}
  <div class="photo-strip">
    {% for foto in fotos %}
    <div class="photo"><img src="{{ foto }}" alt=""></div>
    {% endfor %}
  </div>
  {% endif %}
</article>
